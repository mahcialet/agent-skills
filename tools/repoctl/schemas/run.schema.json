{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "repoctl local execution evidence v1",
  "type": "object",
  "required": ["schema_version", "run_id", "parent_run_id", "attempt_id", "command", "status", "operation_result", "subject_result", "started_at", "ended_at", "duration_seconds", "evidence_class", "provenance_kind", "owned_resources", "cleanup_result", "exit_code", "tasks", "run_dir", "python", "platform", "git"],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"enum": ["PASS", "FAIL", "ERROR", "BLOCKED"]},
    "exit_code": {"enum": [0, 1, 2, 3, 130]},
    "tasks": {"type": "array", "items": {"type": "object", "required": ["id", "status", "argv", "cwd", "duration_seconds"]}}
  }
}
