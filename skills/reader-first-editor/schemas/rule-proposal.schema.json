{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mahcialet/agent-skills/reader-first-editor/rule-proposal.schema.json",
  "title": "Reader-First Editor rule proposal",
  "$comment": "Schema validity never authorizes rule apply; regression pass and human approval are separate apply gates.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "schema_version",
    "investigation_id",
    "created_at",
    "status",
    "hypothesis",
    "scope",
    "mechanism",
    "support",
    "counterexamples",
    "boundary_pairs",
    "existing_rule_analysis",
    "semantic_risks",
    "provenance_reviewed",
    "fixed_threshold_only",
    "frequency_only",
    "duplicate_rule",
    "rule_diff",
    "evals",
    "regressions",
    "human_approval"
  ],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "schema_version": {"const": 1},
    "investigation_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "status": {"enum": ["PROMOTE", "REJECT", "HOLD", "NEEDS_MORE_EVIDENCE"]},
    "hypothesis": {"type": "string", "minLength": 1},
    "scope": {
      "type": "object",
      "required": ["languages", "genres", "readers", "purposes"],
      "properties": {
        "languages": {"type": "array", "minItems": 1, "items": {"enum": ["ja", "en"]}},
        "genres": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "readers": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "purposes": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "mechanism": {"type": "string", "minLength": 1},
    "support": {
      "type": "object",
      "required": ["independent_sources", "record_ids", "correlation_groups"],
      "properties": {
        "independent_sources": {"type": "integer", "minimum": 0},
        "record_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "correlation_groups": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "counterexamples": {
      "type": "object",
      "required": ["searched", "explained", "unexplained"],
      "properties": {
        "searched": {"type": "boolean"},
        "explained": {"type": "array", "items": {"type": "string"}},
        "unexplained": {"type": "array", "items": {"type": "string"}}
      }
    },
    "boundary_pairs": {"type": "array", "items": {"type": "object"}},
    "existing_rule_analysis": {"type": "string", "minLength": 1},
    "semantic_risks": {"type": "array", "items": {"type": "string"}},
    "provenance_reviewed": {"type": "boolean"},
    "fixed_threshold_only": {"type": "boolean"},
    "frequency_only": {"type": "boolean"},
    "duplicate_rule": {"type": "boolean"},
    "rule_diff": {"type": ["string", "null"]},
    "evals": {
      "type": "object",
      "required": ["positive", "negative", "boundary"],
      "properties": {
        "positive": {"type": "array", "items": {"type": "string"}},
        "negative": {"type": "array", "items": {"type": "string"}},
        "boundary": {"type": "array", "items": {"type": "string"}}
      }
    },
    "regressions": {
      "type": "object",
      "required": ["existing_evals", "semantic_preservation", "unnecessary_revision", "literal", "register"],
      "properties": {
        "existing_evals": {"enum": ["pass", "fail", "not-run"]},
        "semantic_preservation": {"enum": ["pass", "fail", "not-run"]},
        "unnecessary_revision": {"enum": ["pass", "fail", "not-run"]},
        "literal": {"enum": ["pass", "fail", "not-run"]},
        "register": {"enum": ["pass", "fail", "not-run"]}
      }
    },
    "human_approval": {
      "type": "object",
      "required": ["approved", "reviewer", "approved_at"],
      "properties": {
        "approved": {"type": "boolean"},
        "reviewer": {"type": ["string", "null"]},
        "approved_at": {"type": ["string", "null"]}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "PROMOTE"}}},
      "then": {
        "properties": {
          "provenance_reviewed": {"const": true},
          "fixed_threshold_only": {"const": false},
          "frequency_only": {"const": false},
          "duplicate_rule": {"const": false},
          "counterexamples": {
            "properties": {
              "searched": {"const": true},
              "unexplained": {"maxItems": 0}
            }
          },
          "support": {
            "properties": {
              "independent_sources": {"minimum": 2},
              "record_ids": {"minItems": 2},
              "correlation_groups": {"minItems": 2}
            }
          },
          "boundary_pairs": {"minItems": 1},
          "rule_diff": {"type": "string", "minLength": 1},
          "evals": {
            "properties": {
              "positive": {"minItems": 1},
              "negative": {"minItems": 1},
              "boundary": {"minItems": 1}
            }
          }
        }
      }
    }
  ]
}
