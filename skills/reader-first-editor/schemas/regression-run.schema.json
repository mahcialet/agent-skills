{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mahcialet/agent-skills/reader-first-editor/regression-run.schema.json",
  "title": "Reader-First Editor regression run",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "schema_version", "plan_id", "provider", "model", "model_version", "host_version", "repeat_index", "created_at", "cases"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "schema_version": {"const": 1},
    "plan_id": {"type": "string", "pattern": "^rfrp-[0-9a-f]{20}$"},
    "provider": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "model_version": {"type": "string", "minLength": 1},
    "host_version": {"type": "string", "minLength": 1},
    "repeat_index": {"type": "integer", "minimum": 1},
    "created_at": {"type": "string", "minLength": 1},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "expected_behavior_match", "dimensions", "notes"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "status": {"enum": ["pass", "fail", "unsupported", "error"]},
          "expected_behavior_match": {"type": "boolean"},
          "dimensions": {
            "type": "object",
            "additionalProperties": false,
            "required": ["semantic_preservation", "unnecessary_revision", "literal", "register"],
            "properties": {
              "semantic_preservation": {"enum": ["pass", "fail", "not-applicable"]},
              "unnecessary_revision": {"enum": ["pass", "fail", "not-applicable"]},
              "literal": {"enum": ["pass", "fail", "not-applicable"]},
              "register": {"enum": ["pass", "fail", "not-applicable"]}
            }
          },
          "notes": {"type": "string"}
        }
      }
    }
  }
}
