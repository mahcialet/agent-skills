{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mahcialet/agent-skills/reader-first-editor/regression-run.schema.json",
  "title": "Reader-First Editor regression run",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "schema_version", "plan_id", "provider", "model", "model_version", "host_version", "repeat_index", "created_at", "cases"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "schema_version": {"const": 2},
    "plan_id": {"type": "string", "pattern": "^rfrp-[0-9a-f]{20}$"},
    "provider": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "model_version": {"type": "string", "minLength": 1},
    "host_version": {"type": "string", "minLength": 1},
    "repeat_index": {"type": "integer", "minimum": 1},
    "created_at": {"type": "string", "minLength": 1},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "expected_behavior_match", "dimensions", "notes"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "status": {"enum": ["pass", "fail", "unsupported", "error"]},
          "expected_behavior_match": {"type": "boolean"},
          "dimensions": {
            "type": "object",
            "additionalProperties": false,
            "required": ["semantic_preservation", "unnecessary_revision", "literal", "register"],
            "properties": {
              "semantic_preservation": {"enum": ["pass", "fail", "not-applicable"]},
              "unnecessary_revision": {"enum": ["pass", "fail", "not-applicable"]},
              "literal": {"enum": ["pass", "fail", "not-applicable"]},
              "register": {"enum": ["pass", "fail", "not-applicable"]}
            }
          },
          "notes": {"type": "string"},
          "observed_risks": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^RR-(0[1-9]|1[0-6])$"}},
          "observed_statuses": {"type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": {"enum": ["VERIFIED", "CONTRADICTED", "SUPPORTED-BY-CITATION", "UNSUPPORTED", "UNVERIFIED"]}},
          "observed_evidence_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["DOC↔CODE", "DOC↔CONFIG", "DOC↔TEST", "DOC↔DOC", "DOC↔HISTORY", "CITATION", "EVIDENCE-GAP", "UNVERIFIED"]}}
        },
        "allOf": [
          {
            "if": {"properties": {"status": {"enum": ["pass", "fail"]}}, "required": ["status"]},
            "then": {
              "dependentRequired": {
                "observed_statuses": ["observed_evidence_types"],
                "observed_evidence_types": ["observed_statuses"]
              }
            }
          },
          {
            "if": {"properties": {"observed_statuses": {"contains": {"enum": ["VERIFIED", "CONTRADICTED"]}}}, "required": ["observed_statuses"]},
            "then": {"properties": {"observed_evidence_types": {"items": {"enum": ["DOC↔CODE", "DOC↔CONFIG", "DOC↔TEST", "DOC↔DOC", "DOC↔HISTORY"]}}}}
          },
          {
            "if": {"properties": {"observed_statuses": {"contains": {"const": "SUPPORTED-BY-CITATION"}}}, "required": ["observed_statuses"]},
            "then": {"properties": {"observed_evidence_types": {"items": {"const": "CITATION"}}}}
          },
          {
            "if": {"properties": {"observed_statuses": {"contains": {"const": "UNSUPPORTED"}}}, "required": ["observed_statuses"]},
            "then": {"properties": {"observed_evidence_types": {"items": {"const": "EVIDENCE-GAP"}}}}
          },
          {
            "if": {"properties": {"observed_statuses": {"contains": {"const": "UNVERIFIED"}}}, "required": ["observed_statuses"]},
            "then": {"properties": {"observed_evidence_types": {"items": {"const": "UNVERIFIED"}}}}
          }
        ]
      }
    }
  }
}
