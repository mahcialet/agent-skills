{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mahcialet/agent-skills/reader-first-editor/regression-report.schema.json",
  "title": "Reader-First Editor regression report",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "schema_version", "plan_id", "proposal_id", "diff_hash", "created_at", "run_ids", "coverage", "metrics", "gates", "status", "blockers"],
  "properties": {
    "id": {"type": "string", "pattern": "^rfrt-[0-9a-f]{20}$"},
    "schema_version": {"const": 1},
    "plan_id": {"type": "string", "pattern": "^rfrp-[0-9a-f]{20}$"},
    "proposal_id": {"type": "string", "pattern": "^rfp-[0-9a-f]{20}$"},
    "diff_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "created_at": {"type": "string", "minLength": 1},
    "run_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["providers_planned", "providers_completed", "runs_planned", "runs_completed", "cases_per_run"],
      "properties": {
        "providers_planned": {"type": "integer", "minimum": 1},
        "providers_completed": {"type": "integer", "minimum": 0},
        "runs_planned": {"type": "integer", "minimum": 1},
        "runs_completed": {"type": "integer", "minimum": 0},
        "cases_per_run": {"type": "integer", "minimum": 1}
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_results", "passed", "failed", "unsupported", "errors", "no_change_total", "no_change_matched", "no_change_accuracy"],
      "properties": {
        "case_results": {"type": "integer", "minimum": 0},
        "passed": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "unsupported": {"type": "integer", "minimum": 0},
        "errors": {"type": "integer", "minimum": 0},
        "no_change_total": {"type": "integer", "minimum": 0},
        "no_change_matched": {"type": "integer", "minimum": 0},
        "no_change_accuracy": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["existing_evals", "corpus_evals", "positive", "negative", "boundary", "semantic_preservation", "unnecessary_revision", "literal", "register", "no_change_accuracy", "provider_compatibility", "repeat_completeness"],
      "properties": {
        "existing_evals": {"enum": ["pass", "fail"]},
        "corpus_evals": {"enum": ["pass", "fail"]},
        "positive": {"enum": ["pass", "fail"]},
        "negative": {"enum": ["pass", "fail"]},
        "boundary": {"enum": ["pass", "fail"]},
        "semantic_preservation": {"enum": ["pass", "fail"]},
        "unnecessary_revision": {"enum": ["pass", "fail"]},
        "literal": {"enum": ["pass", "fail"]},
        "register": {"enum": ["pass", "fail"]},
        "no_change_accuracy": {"enum": ["pass", "fail"]},
        "provider_compatibility": {"enum": ["pass", "fail"]},
        "repeat_completeness": {"enum": ["pass", "fail"]}
      }
    },
    "status": {"enum": ["pass", "fail"]},
    "blockers": {"type": "array", "items": {"type": "string"}}
  }
}
