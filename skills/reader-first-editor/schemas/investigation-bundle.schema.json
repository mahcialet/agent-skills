{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mahcialet/agent-skills/reader-first-editor/investigation-bundle.schema.json",
  "title": "Reader-First Editor investigation bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "schema_version",
    "created_at",
    "actor",
    "reason",
    "hypothesis",
    "scope",
    "selection",
    "records",
    "source_analysis",
    "roles",
    "readiness",
    "output_contract"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^rfb-[0-9a-f]{20}$"},
    "schema_version": {"const": 1},
    "created_at": {"type": "string", "minLength": 1},
    "actor": {"type": "string", "minLength": 1},
    "reason": {"type": "string", "minLength": 1},
    "hypothesis": {"type": "string", "minLength": 1},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["languages", "genres", "readers", "purposes", "translation_status"],
      "properties": {
        "languages": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["ja", "en"]}},
        "genres": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "readers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "purposes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "translation_status": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["support_record_ids", "control_record_ids"],
      "properties": {
        "support_record_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "control_record_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "role",
          "state",
          "language",
          "translation_status",
          "genre",
          "reader",
          "sample_type",
          "quality_class",
          "expected_behavior",
          "source",
          "rights",
          "text_reference"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "role": {"enum": ["support", "control"]},
          "state": {"enum": ["accepted", "rejected", "promoted"]},
          "language": {"enum": ["ja", "en"]},
          "translation_status": {"type": "string", "minLength": 1},
          "genre": {"type": "string", "minLength": 1},
          "reader": {"type": "string", "minLength": 1},
          "sample_type": {"type": "string", "minLength": 1},
          "quality_class": {"enum": ["problematic", "clean", "borderline"]},
          "expected_behavior": {"type": "string", "minLength": 1},
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "repository", "pr_number", "revision", "file", "url", "correlation_group"],
            "properties": {
              "type": {"type": "string", "minLength": 1},
              "repository": {"type": ["string", "null"]},
              "pr_number": {"type": ["integer", "null"]},
              "revision": {"type": "string", "minLength": 1},
              "file": {"type": ["string", "null"]},
              "url": {"type": ["string", "null"]},
              "correlation_group": {"type": "string", "minLength": 1}
            }
          },
          "rights": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "local_only"],
            "properties": {
              "status": {"type": "string", "minLength": 1},
              "local_only": {"type": "boolean"}
            }
          },
          "text_reference": {
            "type": "object",
            "additionalProperties": false,
            "required": ["storage", "content_hash", "record_path", "raw_text_copied"],
            "properties": {
              "storage": {"type": "string", "minLength": 1},
              "content_hash": {"type": "string", "minLength": 1},
              "record_path": {"type": "string", "minLength": 1},
              "raw_text_copied": {"const": false}
            }
          }
        }
      }
    },
    "source_analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_count", "correlation_groups", "repositories", "independent_sources"],
      "properties": {
        "record_count": {"type": "integer", "minimum": 1},
        "correlation_groups": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "repositories": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "independent_sources": {"type": "integer", "minimum": 0}
      }
    },
    "roles": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "priority", "instructions", "required_output"],
        "properties": {
          "name": {"enum": ["Pattern Miner", "Counterexample Hunter", "Boundary Tester", "Regression Analyst", "Rule Reviewer"]},
          "priority": {"type": "integer", "minimum": 1},
          "instructions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "required_output": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default_decision", "blockers"],
      "properties": {
        "default_decision": {"enum": ["HOLD", "NEEDS_MORE_EVIDENCE"]},
        "blockers": {"type": "array", "items": {"type": "string"}}
      }
    },
    "output_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "default_decision", "promote_is_not_apply"],
      "properties": {
        "schema": {"const": "schemas/investigation.schema.json"},
        "default_decision": {"const": "HOLD"},
        "promote_is_not_apply": {"const": true}
      }
    }
  }
}
