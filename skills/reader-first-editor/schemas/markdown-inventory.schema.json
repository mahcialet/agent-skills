{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/reader-first-editor/markdown-inventory.schema.json",
  "title": "Reader-First Editor Markdown inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "inventory_type",
    "source",
    "source_hash",
    "status",
    "max_chars",
    "line_count",
    "chunk_count",
    "limitations",
    "chunks"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "inventory_type": {"const": "markdown-structure"},
    "source": {"type": "string", "minLength": 1},
    "source_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "status": {"enum": ["complete", "partial"]},
    "max_chars": {"type": "integer", "minimum": 1},
    "line_count": {"type": "integer", "minimum": 1},
    "chunk_count": {"type": "integer", "minimum": 1},
    "limitations": {
      "type": "array",
      "items": {"type": "string"}
    },
    "chunks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/chunk"}
    }
  },
  "$defs": {
    "chunk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chunk_id",
        "source",
        "start_line",
        "end_line",
        "headings",
        "block_kinds",
        "protected_block",
        "oversized",
        "text"
      ],
      "properties": {
        "chunk_id": {"type": "string", "pattern": "^CHUNK-[0-9]{4}$"},
        "source": {"type": "string", "minLength": 1},
        "start_line": {"type": "integer", "minimum": 1},
        "end_line": {"type": "integer", "minimum": 1},
        "headings": {
          "type": "array",
          "items": {"type": "string"}
        },
        "block_kinds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": ["heading", "paragraph", "table", "list", "code-fence"]
          }
        },
        "protected_block": {"type": "boolean"},
        "oversized": {"type": "boolean"},
        "text": {"type": "string", "minLength": 1}
      }
    }
  }
}
