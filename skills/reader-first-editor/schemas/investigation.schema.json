{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mahcialet/agent-skills/reader-first-editor/investigation.schema.json",
  "title": "Reader-First Editor rule investigation",
  "$comment": "Schema validity records investigation data; only PROMOTE-specific invariants below authorize a proposal recommendation, never rule apply.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "schema_version",
    "created_at",
    "hypothesis",
    "scope",
    "record_ids",
    "source_correlation",
    "support",
    "counterexamples",
    "boundary_pairs",
    "existing_rule_analysis",
    "semantic_risks",
    "proposed_evals",
    "decision"
  ],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "schema_version": {"const": 1},
    "created_at": {"type": "string", "minLength": 1},
    "hypothesis": {"type": "string", "minLength": 1},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["languages", "genres", "readers", "purposes", "translation_status"],
      "properties": {
        "languages": {"type": "array", "minItems": 1, "items": {"enum": ["ja", "en"]}},
        "genres": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "readers": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "purposes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "translation_status": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "record_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "source_correlation": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "support": {
      "type": "object",
      "required": ["independent_sources", "examples", "mechanism", "confounders"],
      "properties": {
        "independent_sources": {"type": "integer", "minimum": 0},
        "examples": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "mechanism": {"type": "string"},
        "confounders": {"type": "array", "items": {"type": "string"}}
      }
    },
    "counterexamples": {
      "type": "object",
      "required": ["searched", "explained", "unexplained"],
      "properties": {
        "searched": {"type": "boolean"},
        "explained": {"type": "array", "items": {"type": "string"}},
        "unexplained": {"type": "array", "items": {"type": "string"}}
      }
    },
    "boundary_pairs": {"type": "array", "items": {"type": "object"}},
    "existing_rule_analysis": {"type": "string"},
    "semantic_risks": {"type": "array", "items": {"type": "string"}},
    "proposed_evals": {
      "type": "object",
      "required": ["positive", "negative", "boundary"],
      "properties": {
        "positive": {"type": "array", "items": {"type": "string"}},
        "negative": {"type": "array", "items": {"type": "string"}},
        "boundary": {"type": "array", "items": {"type": "string"}}
      }
    },
    "decision": {
      "type": "object",
      "required": ["status", "reason"],
      "properties": {
        "status": {"enum": ["PROMOTE", "REJECT", "HOLD", "NEEDS_MORE_EVIDENCE"]},
        "reason": {"type": "string", "minLength": 1}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {"properties": {"status": {"const": "PROMOTE"}}}
        }
      },
      "then": {
        "properties": {
          "counterexamples": {
            "properties": {
              "searched": {"const": true},
              "unexplained": {"maxItems": 0}
            }
          },
          "support": {
            "properties": {
              "independent_sources": {"minimum": 2},
              "examples": {"minItems": 2}
            }
          },
          "source_correlation": {"minItems": 2},
          "boundary_pairs": {"minItems": 1},
          "proposed_evals": {
            "properties": {
              "positive": {"minItems": 1},
              "negative": {"minItems": 1},
              "boundary": {"minItems": 1}
            }
          }
        }
      }
    }
  ]
}
