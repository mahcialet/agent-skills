{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agent-skills/ticket-state/template.schema.json",
  "title": "ticket-state local template candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "template_id", "kind", "status", "markup", "sample_count", "headings", "exceptions", "evidence", "created_at", "approved", "candidate_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "template_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "kind": {"enum": ["candidate", "approved"]},
    "status": {"enum": ["CANDIDATE", "NEEDS_MORE_EVIDENCE", "NEEDS_REVIEW", "APPROVED"]},
    "markup": {"enum": ["markdown", "textile", "backlog"]},
    "sample_count": {"type": "integer", "minimum": 1},
    "headings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "observed_count", "required_candidate", "confidence"],
        "properties": {
          "title": {"type": "string", "minLength": 1},
          "observed_count": {"type": "integer", "minimum": 1},
          "required_candidate": {"type": "boolean"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "exceptions": {"type": "array", "items": {"type": "array", "items": {"type": "string"}}},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["identity", "retrieved_at", "description_sha256"],
        "properties": {
          "identity": {"type": "object"},
          "retrieved_at": {"type": "string"},
          "description_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "created_at": {"type": "string", "minLength": 1},
    "approved": {"type": "boolean"},
    "candidate_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "approved_at": {"type": "string"},
    "approved_by": {"type": "string", "minLength": 1},
    "approval_reason": {"type": "string", "minLength": 1},
    "source_candidate_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_candidate_status": {"enum": ["CANDIDATE", "NEEDS_MORE_EVIDENCE", "NEEDS_REVIEW"]}
  },
  "allOf": [
    {
      "if": {"properties": {"kind": {"const": "candidate"}}, "required": ["kind"]},
      "then": {
        "properties": {
          "approved": {"const": false},
          "status": {"enum": ["CANDIDATE", "NEEDS_MORE_EVIDENCE", "NEEDS_REVIEW"]}
        },
        "not": {
          "anyOf": [
            {"required": ["approved_at"]},
            {"required": ["approved_by"]},
            {"required": ["approval_reason"]},
            {"required": ["source_candidate_sha256"]},
            {"required": ["source_candidate_status"]}
          ]
        }
      }
    },
    {
      "if": {"properties": {"kind": {"const": "approved"}}, "required": ["kind"]},
      "then": {
        "properties": {
          "approved": {"const": true},
          "status": {"const": "APPROVED"}
        },
        "required": [
          "approved_at",
          "approved_by",
          "approval_reason",
          "source_candidate_sha256",
          "source_candidate_status"
        ]
      }
    }
  ]
}
